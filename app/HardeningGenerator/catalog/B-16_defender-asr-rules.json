{
  "$schemaVersion": "0.1",
  "id": "intune.defender.asrRules",
  "checklistNr": "B-16",
  "workload": "Intune",
  "category": "Antivirus",
  "title": "Defender: Regeln zur Verringerung der Angriffsflaeche (ASR)",
  "description": "Aktiviert alle 19 ASR-Regeln von Microsoft Defender in einem Settings-Catalog-Profil. Im sicheren Modus ausschliesslich im AUDIT-Modus (protokolliert, blockiert nicht).",
  "tier": "Best Practice",
  "riskClass": "B",
  "riskRationale": "ASR-Regeln im Block-Modus koennen legitime Anwendungen, Makros, Skripte oder Verwaltungstools stoeren (z. B. PSExec/WMI-Regel ist mit ConfigMgr unvertraeglich). Darum nur Audit erzeugbar; Umstellung auf Block regelweise nach Auswertung der Audit-Ereignisse.",
  "safeMode": {
    "assignment": "unassigned",
    "mode": "audit",
    "note": "Erzeugt alle Regeln im Audit-Modus und ohne Zuweisung. Keine Ausschluesse - die sind kundenspezifisch und werden nach Auswertung manuell gepflegt."
  },
  "ui": {
    "selectable": true,
    "locked": false,
    "subSelectable": true,
    "warnText": "Betriebskritisch: wird nur im Audit-Modus erzeugt. Block je Regel und Zuweisung bewusst manuell nach Auswertung (Defender-Portal > Berichte > Verringerung der Angriffsflaeche)."
  },
  "requiredScopes": [
    "DeviceManagementConfiguration.ReadWrite.All"
  ],
  "naming": {
    "prefix": "4S-",
    "policyName": "4S-Defender-ASR-Audit"
  },
