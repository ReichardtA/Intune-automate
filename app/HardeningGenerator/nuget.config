<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Fuegt nuget.org hinzu (ohne vorhandene Firmen-Feeds zu entfernen). -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <!-- Hebt ein evtl. geerbtes Deaktivieren von nuget.org wieder auf. -->
    <clear />
  </disabledPackageSources>
</configuration>
