<Window x:Class="HardeningGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="4sight Hardening Generator (Prototyp)" Height="640" Width="1000"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Zeilenfarbe nach Risikoklasse -->
        <Style x:Key="RiskRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RiskClass}" Value="B">
                    <Setter Property="Background" Value="#FFF8E6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RiskClass}" Value="C">
                    <Setter Property="Background" Value="#F0F0F0" />
                    <Setter Property="Foreground" Value="#8A8A8A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Titel -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="4sight Hardening Generator" FontSize="20" FontWeight="Bold" Foreground="#1F3864" />
            <TextBlock Text="Einstellungen waehlen und ein PowerShell-Skript erzeugen. Nichts wird live veraendert."
                       Foreground="#555555" />
        </StackPanel>

        <!-- Break-Glass -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Break-Glass-Konten (UPN, mehrere mit Komma/Semikolon):"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Width="420" Text="{Binding BreakGlass, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Diese Konten werden im erzeugten Skript blockiert (Ausfuehrung verweigert)." />
        </StackPanel>

        <!-- Liste -->
        <ListView Grid.Row="2" ItemsSource="{Binding GroupedSettings}"
                  ItemContainerStyle="{StaticResource RiskRowStyle}"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                       Foreground="#1F3864" Margin="2,10,0,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="44">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanSelect}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Nr." Width="60" DisplayMemberBinding="{Binding Nr}" />
                    <GridViewColumn Header="Einstellung" Width="300" DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="Tier" Width="100" DisplayMemberBinding="{Binding Tier}" />
                    <GridViewColumn Header="Risiko" Width="120" DisplayMemberBinding="{Binding RiskLabel}" />
                    <GridViewColumn Header="Hinweis" Width="330">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Foreground="#9C5700" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Fusszeile -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" VerticalAlignment="Center" Foreground="#333333" />
            <Button DockPanel.Dock="Right" Content="Skript erzeugen..." Padding="14,6"
                    FontWeight="SemiBold" Click="GenerateButton_Click" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#888888"
                       Text="Legende: weiss = A sicher  |  gelb = B (sichere Form)  |  grau = C gesperrt" />
        </DockPanel>
    </Grid>
</Window>
